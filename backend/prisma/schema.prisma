generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuestionType {
  multipleChoice
  trueFalse
  written
}

model User {
  id                  String          @id @default(uuid())
  username            String          @unique
  password            String
  flashcardSets       FlashcardSet[]  @relation("createdFlashcardSets")
  viewedFlashcardSets FlashcardView[] @relation("viewedFlashcardSets")
  learnSessions       LearnSession[]
}

model Flashcard {
  id                    String                 @id @default(uuid())
  index                 Int
  term                  String
  definition            String
  flashcardSet          FlashcardSet           @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)
  flashcardSetId        String
  learnSessionQuestions LearnSessionQuestion[]
}

model FlashcardSet {
  id            String          @id @default(uuid())
  name          String
  description   String
  flashcards    Flashcard[]
  creator       User            @relation(name: "createdFlashcardSets", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId     String
  views         FlashcardView[]
  learnSessions LearnSession[]
  createdAt     DateTime        @default(now())
  editedAt      DateTime        @updatedAt
}

model FlashcardView {
  id             String       @id @default(uuid())
  flashcardSet   FlashcardSet @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)
  flashcardSetId String
  user           User         @relation(name: "viewedFlashcardSets", fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  viewedAt       DateTime     @default(now())

  @@unique([flashcardSetId, userId])
}

model LearnSessionQuestion {
  id             String       @id @default(uuid())
  order          Int
  type           QuestionType
  flashcard      Flashcard    @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  flashcardId    String
  learnSession   LearnSession @relation(fields: [learnSessionId], references: [id], onDelete: Cascade)
  learnSessionId String
}

model LearnSession {
  id                    String                 @id @default(uuid())
  amountPerSession      Int
  multipleChoiceAmount  Int
  trueFalseAmount       Int
  writtenAmount         Int
  learnSessionQuestions LearnSessionQuestion[]
  flashcardSet          FlashcardSet           @relation(fields: [flashcardSetId], references: [id], onDelete: Cascade)
  flashcardSetId        String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String

  @@unique([flashcardSetId, userId])
}
